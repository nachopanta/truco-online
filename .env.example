# Credenciales del proyecto Supabase (Project Settings > API > Publishable and secret API keys)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_tu-key

# Solo para tareas de servidor con privilegios elevados (backups, exportaciones).
# Nunca exponer al cliente ni versionar el valor real.
SUPABASE_SECRET_KEY=sb_secret_tu-key
